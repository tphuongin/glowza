<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderBrushSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="5"
        android:valueTo="100"
        android:value="20"
        app:thumbColor="@color/primary"
        app:trackColorActive="@color/primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_eraser"
            app:tint="@color/onSurface"
            android:alpha="0.6" />

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#DDD" android:layout_marginHorizontal="4dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrawColors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#DDD" android:layout_marginHorizontal="4dp"/>

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo"
            app:tint="@color/onSurface" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo"
            app:tint="@color/onSurface" />

        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exit"
            app:tint="@color/error" />

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#DDD" android:layout_marginHorizontal="4dp"/>

        <ImageButton
            android:id="@+id/btnConfirmDraw"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="@color/primary" />
    </LinearLayout>
</LinearLayout>