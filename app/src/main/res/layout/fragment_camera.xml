<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.camera.fragment.CameraFragment">

    <View
        android:id="@+id/view_bonus"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bonus_view"
        android:background="#B0000000"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/view_top_letterbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#B0000000"
        app:layout_constraintTop_toBottomOf="@id/view_bonus"
        app:layout_constraintBottom_toTopOf="@id/frame_camera_preview" />

    <View
        android:id="@+id/view_bottom_letterbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#B0000000"
        app:layout_constraintTop_toBottomOf="@id/frame_camera_preview"
        app:layout_constraintBottom_toTopOf="@id/rv_mode_camera" />

    <FrameLayout
        android:id="@+id/frame_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toBottomOf="@id/view_top_letterbox"
        app:layout_constraintBottom_toTopOf="@id/view_bottom_letterbox">


        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <View
            android:id="@+id/viewColorFilterOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.0" />

        <com.sgroupmobile.glowza.view.CameraOverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ImageView
            android:id="@+id/iv_transition_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/timer_notification"
        android:gravity="center"
        android:textSize="@dimen/middle_text"
        android:textColor="@color/white"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_top_letterbox"
        android:layout_marginTop="@dimen/middle_margin"/>

    <ImageButton
        android:id="@+id/btn_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_zoom_button"
        android:src="@drawable/zoom_in"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/frame_camera_preview"
        android:layout_margin="@dimen/normal_bottom_margin"/>
    <TextView
        android:id="@+id/tv_video_timer"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="@dimen/timer_height"
        app:layout_constraintTop_toTopOf="@id/btn_zoom"
        app:layout_constraintBottom_toBottomOf="@id/btn_zoom"
        android:layout_margin="@dimen/timer_margin"
        android:text="@string/video_timer_default"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="@dimen/content_text" />

    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/primary"
        android:textSize="@dimen/big_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textStyle="bold"/>

    <ImageButton
        android:id="@+id/btn_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="@dimen/button_side_padding"
        android:layout_marginStart="@dimen/normal_padding"
        android:src="@drawable/exit"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_exit"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="@dimen/button_side_padding"
        android:src="@drawable/ic_setting"
        android:layout_marginEnd="@dimen/normal_padding"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_exit"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit"
        app:layout_constraintEnd_toStartOf="@id/btn_setting"
        android:padding="@dimen/button_side_padding"
        android:src="@drawable/switch_direction"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_exit"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit"
        app:layout_constraintEnd_toStartOf="@id/btn_switch"
        android:padding="@dimen/button_side_padding"
        android:src="@drawable/ic_flash"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_snap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/snap_margin_bottom"
        android:src="@drawable/snap"
        android:background="@android:color/transparent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_filters"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/btn_snap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_filter_container" />

    <ImageButton
        android:id="@+id/btn_face_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/btn_snap"
        android:src="@drawable/ic_face_filter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_snap"
        app:layout_constraintEnd_toStartOf="@id/btn_snap"
        android:padding="@dimen/button_side_padding"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_image_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_snap"
        app:layout_constraintBottom_toBottomOf="@id/btn_snap"
        android:src="@drawable/ic_image_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_snap"
        android:padding="@dimen/button_side_padding"
        android:background="@android:color/transparent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mode_camera"
        android:layout_width="match_parent"
        android:clipToPadding="false"
        android:layout_height="@dimen/tab_camera_height"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:id="@+id/view_flash_effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>