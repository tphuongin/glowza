<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.camera.fragment.CameraFragment">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/onSurface"/>

    <ImageButton
        android:id="@+id/btn_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="@dimen/button_side_padding"
        android:layout_marginStart="@dimen/normal_padding"
        android:src="@drawable/exit"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_exit"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="@dimen/button_side_padding"
        android:src="@drawable/setting"
        android:layout_marginEnd="@dimen/normal_padding"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_exit"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit"
        app:layout_constraintEnd_toStartOf="@id/btn_setting"
        android:padding="@dimen/button_side_padding"
        android:src="@drawable/flash"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_exit"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit"
        app:layout_constraintEnd_toStartOf="@id/btn_flash"
        android:padding="@dimen/button_side_padding"
        android:src="@drawable/switch_direction"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_snap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="@dimen/normal_padding"
        android:src="@drawable/snap"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_face_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/btn_snap"
        android:src="@drawable/face_filter"
        android:paddingBottom="@dimen/normal_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_snap"
        app:layout_constraintEnd_toStartOf="@id/btn_snap"
        android:background="@android:color/transparent"/>

    <ImageButton
        android:id="@+id/btn_image_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_snap"
        app:layout_constraintBottom_toBottomOf="@id/btn_snap"
        android:paddingBottom="@dimen/normal_padding"
        android:src="@drawable/image_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_snap"
        android:background="@android:color/transparent"/>


</androidx.constraintlayout.widget.ConstraintLayout>