<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="@dimen/normal_padding">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/normal_bottom_margin"
        android:background="@color/onBackground" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/padding_vertical">

        <ImageView
            android:id="@+id/ic_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_timer"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_vertical"
            android:layout_toEndOf="@id/ic_timer"
            android:textColor="@color/onSurface"
            android:layout_centerVertical="true"
            android:text="@string/setting_timer"
            android:textSize="@dimen/content_text" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timer_off"
                android:checked="true"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/setting_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="@string/setting_timer_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timer_3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/setting_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timer_5"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/setting_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timer_9"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/setting_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="9" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#222222" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/padding_vertical">

        <ImageView
            android:id="@+id/ic_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_aspect_ratio"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/ic_ratio"
            android:textColor="@color/onSurface"
            android:text="@string/setting_ratio"
            android:textSize="@dimen/content_text" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ratio_9_16"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/ratio_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="9:16" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ratio_3_4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/ratio_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="3:4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ratio_1_1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/ratio_button_width"
                android:layout_height="@dimen/setting_button_height"
                android:textColor="@color/onSurface"
                android:text="1:1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#222222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_grid"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_vertical"
            android:layout_weight="1"
            android:text="@string/setting_grid"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/content_text" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/selector_switch_thumb"
            app:trackTint="@color/selector_switch_track" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#222222" />

</LinearLayout>